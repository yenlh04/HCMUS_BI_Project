  <MdxScripts>
    <MdxScript dwd:design-time-name="e90e0037-5bfb-4404-8b2e-343262d16427">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[Delay Over 15 Rate]
 AS [Measures].[Delay Over15 Flag] / [Measures].[Flight Performed], 
FORMAT_STRING = "Percent", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[OTP Rate]
 AS [Measures].[OTP Plus Minus5 Flag] / [Measures].[Flight Performed], 
FORMAT_STRING = "Percent", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Cancellation Rate]
 AS [Measures].[Cancelled] / ([Measures].[Fact FLights Count], [Dim Cancellation Reasons].[Reason SK].[All]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Arr Delay]
 AS [Measures].[Arrival Delay] / [Measures].[Flight Performed], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Dept Delay]
 AS [Measures].[Departure Delay] / [Measures].[Flight Performed], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Air Systemr Delay]
 AS [Measures].[Air System Delay] / [Measures].[Flight Performed], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Security Delay]
 AS [Measures].[Security Delay] / [Measures].[Flight Performed], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Airline Delay]
 AS [Measures].[Airline Delay] / [Measures].[Flight Performed], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Late Aircraft Delay]
 AS [Measures].[Late Aircraft Delay] / [Measures].[Flight Performed], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Weather Delay]
 AS [Measures].[Weather Delay] / [Measures].[Flight Performed], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Pct Contribution To Cancel]
 AS [Measures].[Cancelled] / (ROOT([Origin Airport SK]), [Measures].[Cancelled]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Pct Contribution To Delay]
 AS [Measures].[Delay Over15 Flag] / (ROOT([Origin Airport SK]), [Measures].[Delay Over15 Flag]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>